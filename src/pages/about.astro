---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import PreviewBand from '../components/PreviewBand.astro';
import facts from '../data/facts.json';
---

<Base
  title="About & Visit — Art De Areka, SS2 Petaling Jaya"
  description="A contemporary art gallery in SS2, Petaling Jaya. Free entry. Original Balinese abstraction and Malaysian batik in a calm first-floor space designed for slow looking."
  active="about"
>
  <section class="wrap" style="padding-top:44px">
    <p class="kicker">About the Gallery</p>
    <h1 class="display">The story of an artwork is not finished until it meets its owner</h1>
  </section>

  <section class="wrap story-grid" style="padding-top:28px">
    <div class="prose">
      <p>
        Art De Areka exists to give artists a place to express their ideas and
        emotions through artwork — and to help those works do what they were made
        to do: enliven the spaces people live and work in.
      </p>
      <p>
        We believe artworks are more than decoration. A good painting keeps a room
        company. It changes how the space feels, and after a few years it becomes
        part of how you remember the place.
      </p>
      <p>
        The collection centres on two traditions we love: contemporary Balinese
        abstraction and Malaysian batik fine art. Every piece is an original,
        chosen for how it will sit in a real room.
      </p>
      <p class="muted">
        You don't need to know anything about art to come here. Come up the stairs,
        have a cup of tea with us, take your time. If a painting is meant for you,
        you'll know. And if you'd rather be sure, we'll show it on your own wall first.
      </p>
    </div>
    <aside class="visit-card">
      <div class="sect-head"><h2>Visit</h2></div>
      <p class="v-line"><b>Art De Areka</b></p>
      <p class="v-line">{facts.address.full}</p>
      <p class="v-line">First floor — look for our signboard on Jalan SS 2/67.</p>
      <p class="v-line" style="margin-top:12px">
        <b>Hours</b> · {facts.hoursTime}{facts.hoursDays ? `, ${facts.hoursDays}` : ''}
        {!facts.hoursDays && <span class="pend"> (opening days being confirmed)</span>}
      </p>
      <p class="v-line"><b>Entry</b> · Free, always</p>
      <p style="margin:16px 0 0">
        <a class="btn" href={facts.address.mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a>
      </p>
      <p style="margin:12px 0 0">
        <WhatsAppCTA variant="inline" label="Message us before you come" prefill="Hi Art De Areka, I'm planning to visit the gallery." />
      </p>
    </aside>
  </section>

  <section class="wrap" style="padding-top:50px">
    <div class="sect-head"><h2>The space</h2></div>
    <div class="prose">
      <p>
        One long, calm floor above the shops, under warm light. Abstraction hangs
        beside batik, large canvases beside small ones, and there's room to stand
        back from all of it. Browse as long as you like — nobody will hover.
      </p>
    </div>
  </section>

  <section class="wrap" style="padding-top:50px">
    <div class="submit hairline-block">
      <p class="kicker" style="margin-bottom:8px">Artists — work with us</p>
      <p class="lede" style="margin-bottom:12px">
        The gallery was opened to facilitate artists. If your work belongs on these
        walls, send us a few images — we review every submission personally.
      </p>
      <WhatsAppCTA
        variant="inline"
        label="Send us your work"
        prefill="Hi Art De Areka, I'm an artist and I'd like to show you my work."
      />
    </div>
  </section>

  <PreviewBand />
</Base>

<style>
  .story-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 44px; align-items: start; }
  @media (max-width: 760px) { .story-grid { grid-template-columns: 1fr; } }
  .visit-card { background: var(--wall); padding: 24px; }
  .v-line { font-size: 13.5px; margin: 0 0 5px; color: var(--ink); }
  .v-line b { font-weight: 700; }
  .pend { color: var(--dim); font-size: 12px; }
  .submit { padding: 26px 0; }
</style>
