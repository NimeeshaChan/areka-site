---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
---

<Base
  title="For Designers & Trade — Art De Areka"
  description="Trade program for interior designers, architects and developers: curated artwork proposals, mockups into your renders, staging solutions, project sourcing and installation. Petaling Jaya."
  active="designers"
>
  <section class="wrap" style="padding-top:44px">
    <p class="kicker">For Designers &amp; Trade</p>
    <h1 class="display">We handle the artwork on your projects</h1>
    <p class="lede" style="margin:14px 0 26px">
      Art De Areka works with interior designers, architects and developers on the
      artwork side of a project: curated proposals mocked into your actual space,
      sourcing, then delivery and hanging on site.
    </p>
    <WhatsAppCTA
      label="Start a Trade Conversation"
      prefill="Hi Art De Areka, I'm an interior designer/architect and I'd like to hear about your trade program."
      sub="We reply within one working day"
    />
  </section>

  <section class="wrap" style="padding-top:44px">
    <div class="sect-head"><h2>What the trade program includes</h2></div>
    <div class="offer-grid">
      <div class="offer">
        <h3>Artwork proposals, free</h3>
        <p>Send a client's wall photo or your project rendering — we return 2–3 curated
        options mocked into the actual space, ready to drop into your client presentation.</p>
      </div>
      <div class="offer">
        <h3>Specification support</h3>
        <p>Exact dimensions, medium and framing details for every piece, ready to
        go straight into your project documentation.</p>
      </div>
      <div class="offer">
        <h3>Trade commissions</h3>
        <p>We pay a commission to designers who specify our works. Ask us for the
        current terms.</p>
      </div>
      <div class="offer">
        <h3>Staging &amp; rental solutions</h3>
        <p>Artwork loans for show units, staging and photography — talk to us about
        your project timeline.</p>
      </div>
      <div class="offer">
        <h3>Project-friendly pricing</h3>
        <p>Batch pricing for multi-piece projects: offices, hospitality, clubhouses,
        sales galleries and show units.</p>
      </div>
      <div class="offer">
        <h3>Delivery &amp; installation</h3>
        <p>Coordinated delivery and professional hanging, scheduled around your
        site's handover dates.</p>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-top:50px">
    <div class="sect-head"><h2>Who we work with</h2></div>
    <div class="seg-row">
      <span class="pill">Interior designers</span>
      <span class="pill">Architects</span>
      <span class="pill">Property developers — show units &amp; sales galleries</span>
      <span class="pill">Offices &amp; boardrooms</span>
      <span class="pill">Hotels &amp; F&amp;B</span>
      <span class="pill">Clubhouses &amp; common areas</span>
    </div>
    <p class="lede" style="margin:22px 0 0">
      For show units, we can also put together one coordinated team — gallery,
      interior designer and carpentry workshop — for the complete space. Ask us about it.
    </p>
  </section>

  <section class="band" style="margin-top:54px">
    <div class="wrap band-grid">
      <div>
        <h2 class="title-lg">Send us your current project</h2>
        <p class="lede" style="margin:8px 0 0">
          Send one wall photo or a render and we'll show you how we work.
        </p>
      </div>
      <WhatsAppCTA
        label="Send a Project Wall"
        prefill="Hi Art De Areka, I have a project that needs artwork. Here are the details:"
      />
    </div>
  </section>
</Base>

<style>
  .offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px 30px; }
  @media (max-width: 820px) { .offer-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .offer-grid { grid-template-columns: 1fr; } }
  .offer h3 { font-size: 14px; font-weight: 700; margin: 0 0 6px; }
  .offer p { font-size: 13px; color: var(--dim); margin: 0; }
  .seg-row { display: flex; flex-wrap: wrap; gap: 8px; }
</style>
