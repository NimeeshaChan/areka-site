---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
---

<Base
  title="The Areka Wall Preview — See art on your own wall first"
  description="Send us a photo of your wall on WhatsApp. Within 48 hours, see 2–3 curated artworks placed in your actual room — free, no obligation. See how it sits in your space before you decide."
  active="preview"
>
  <section class="wrap" style="padding-top:44px">
    <p class="kicker">The Areka Wall Preview</p>
    <h1 class="display">See it on your own wall first</h1>
    <p class="lede" style="margin:14px 0 26px">
      Most people find it hard to picture a painting in their own room — the right
      size, the light, the furniture around it. Send us a photo of the wall and we
      will show you exactly that, before you spend anything.
    </p>
    <WhatsAppCTA
      label="Send a Wall Photo"
      prefill="Hi Art De Areka, I'd like a free Wall Preview. Here's my wall:"
      sub="Free · no obligation · 48-hour reply"
    />
  </section>

  <section class="wrap" style="padding-top:44px">
    <div class="sect-head"><h2>How it works</h2></div>
    <ol class="step-list">
      <li>
        <div>
          <h3>Send us your wall</h3>
          <p>One photo of the wall, its rough width and height, and what the room is
          (living room, office reception, bedroom…). WhatsApp is easiest.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>We curate for your space</h3>
          <p>Our curator selects two or three artworks that suit the room's light,
          proportions and mood — with the right artwork size and a price range for each.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>See the before &amp; after</h3>
          <p>Within 48 hours you receive your own wall with each artwork placed in it,
          so you can judge the size and the colours properly. Framing suggestions included.</p>
        </div>
      </li>
      <li>
        <div>
          <h3>Decide at your own pace</h3>
          <p>If one feels right, we arrange a viewing, delivery and hanging. If none
          of them do, that's fine too — the preview is free either way.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="wrap" style="padding-top:50px">
    <div class="sect-head"><h2>Want to go deeper?</h2></div>
    <div class="prose">
      <p>
        The Wall Preview is free for everyone: one wall, two or three curated options,
        within 48 hours.
      </p>
      <p class="muted">
        If you'd like more — several concepts for the same wall, framing and
        wall-panelling ideas, a colour palette, a proper consultation — ask us and
        we'll put something together for you. Interior designers on our
        <a href="/designers" class="textlink">trade program</a> can request previews
        for every project they run.
      </p>
    </div>
  </section>

  <section class="band" style="margin-top:54px">
    <div class="wrap band-grid">
      <div>
        <h2 class="title-lg">It starts with a photo of your wall</h2>
        <p class="lede" style="margin:8px 0 0">
          One WhatsApp message is enough. There's nothing to sign up for.
        </p>
      </div>
      <WhatsAppCTA
        label="Start My Free Preview"
        prefill="Hi Art De Areka, I'd like a free Wall Preview. Here's my wall:"
        sub="Free · no obligation · 48-hour reply"
      />
    </div>
  </section>
</Base>
