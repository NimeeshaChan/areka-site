---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
---

<Base
  title="AREKA Wall Preview™ — See art on your wall first"
  description="Send us a photo of your wall on WhatsApp. Within 48 hours, see 2–3 curated artworks placed in your actual room — free, no obligation. Visualise your wall before you invest."
  active="preview"
>
  <section class="wrap" style="padding-top:44px">
    <p class="kicker">AREKA Wall Preview™</p>
    <h1 class="display">Visualise your wall before you invest</h1>
    <p class="lede" style="margin:14px 0 26px">
      The hardest part of buying art isn't choosing a painting — it's imagining it
      in <i>your</i> room, at the right size, next to your furniture. So we do that
      part for you, before you spend a single ringgit.
    </p>
    <WhatsAppCTA
      label="Send a Wall Photo"
      prefill="Hi Art De Areka, I'd like a free Wall Preview. Here's my wall:"
      sub="Free · no obligation · 48-hour reply"
    />
  </section>

  <section class="wrap" style="padding-top:44px">
    <div class="sect-head"><h2>How it works</h2></div>
    <ol class="step-list">
      <li>
        <div>
          <h4>Send us your wall</h4>
          <p>One photo of the wall, its rough width and height, and what the room is
          (living room, office reception, bedroom…). WhatsApp is easiest — Instagram DM works too.</p>
        </div>
      </li>
      <li>
        <div>
          <h4>We curate for your space</h4>
          <p>Our curator selects two or three artworks that suit the room's light,
          proportions and mood — with the right artwork size and a price range for each.</p>
        </div>
      </li>
      <li>
        <div>
          <h4>See the before &amp; after</h4>
          <p>Within 48 hours you receive your own wall with each artwork placed in it —
          a true preview, not a catalogue photo. Framing suggestions included.</p>
        </div>
      </li>
      <li>
        <div>
          <h4>Decide at your own pace</h4>
          <p>Love one? We arrange a viewing, delivery and hanging. Not this time?
          That's completely fine — the preview is free either way.</p>
        </div>
      </li>
    </ol>
  </section>

  <section class="wrap" style="padding-top:50px">
    <div class="sect-head"><h2>Preview tiers</h2></div>
    <div class="tablewrap">
      <table class="tiers">
        <thead>
          <tr><th>Tier</th><th>What you receive</th><th>Price</th></tr>
        </thead>
        <tbody>
          <tr>
            <td>Wall Preview™</td>
            <td>One wall, one curated artwork proposal with before/after mockup, size guidance and price range.</td>
            <td>Free</td>
          </tr>
          <tr>
            <td>Signature Preview™</td>
            <td class="dim">Three concepts for your wall, artwork curation, mood board and colour palette,
              wainscoting &amp; wall-panelling suggestions, installation recommendations, and a consultation.</td>
            <td class="dim">Ask us</td>
          </tr>
          <tr>
            <td>Designer Partner</td>
            <td class="dim">Unlimited previews for interior designers and trade partners who specify
              Art De Areka artworks in their projects. <a href="/designers" class="textlink">Trade program →</a></td>
            <td class="dim">For trade</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="band" style="margin-top:54px">
    <div class="wrap band-grid">
      <div>
        <h2 class="title-lg">Your wall photo is where every good match starts</h2>
        <p class="lede" style="margin:8px 0 0">
          No account, no form, no commitment — one WhatsApp message.
        </p>
      </div>
      <WhatsAppCTA
        label="Start My Free Preview"
        prefill="Hi Art De Areka, I'd like a free Wall Preview. Here's my wall:"
        sub="Free · no obligation · 48-hour reply"
      />
    </div>
  </section>
</Base>
