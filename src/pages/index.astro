---
import Base from '../layouts/Base.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import PreviewBand from '../components/PreviewBand.astro';
import artworks from '../data/artworks.json';
import facts from '../data/facts.json';

const featured = artworks.filter((a) => a.featured).slice(0, 3);
---

<Base
  title="Art De Areka — Contemporary Art Gallery, SS2 Petaling Jaya"
  description="Curated contemporary art for inspired spaces. Original Balinese abstracts and Malaysian batik, from RM 1,200. Free Wall Preview: see art on your wall before you decide."
>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-txt">
        <p class="kicker">Contemporary Art Gallery · SS2, Petaling Jaya</p>
        <h1 class="display">{facts.tagline}</h1>
        <p class="lede" style="margin:16px 0 26px">
          Original abstracts by <b><a href="/artists/wayan-gede-susana" class="hero-artist">Wayan Gede Susana</a></b> —
          exhibited in Singapore, Sweden and Switzerland — and batik by
          <b><a href="/artists/fauziah-gee-yahaya" class="hero-artist">Fauziah “Gee” Yahaya</a></b>.
          From RM {facts.priceFloor.toLocaleString()}.
        </p>
        <div class="hero-ctas">
          <WhatsAppCTA
            label="Preview Art on Your Wall"
            prefill="Hi Art De Areka, I'd like a free Wall Preview. Here's my wall:"
            sub="Free · no obligation · 48-hour reply"
          />
          <a class="textlink" href="/collection">Browse the collection</a>
        </div>
      </div>
      <div class="hero-art">
        <figure class="frame">
          <div class="ph ph--1" role="img" aria-label="Ethereal Form by Wayan Susana — photography in progress"></div>
          <figcaption>Ethereal Form · Wayan Susana · 110 × 120 cm</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Artist credibility strip -->
  <div class="artist-strip hairline-block">
    <div class="wrap strip-row">
      <span class="serif name">Wayan Gede Susana</span>
      <span class="cv-line">Solo &amp; group exhibitions 1989–2017 · Bali · Singapore · Sweden · Switzerland</span>
    </div>
  </div>

  <!-- Featured works -->
  <section class="wrap" style="padding-top:38px; padding-bottom:44px">
    <div class="sect-head">
      <h2>Featured Works</h2>
      <a href="/collection">All works →</a>
    </div>
    <div class="art-grid">
      {featured.map((a) => <ArtworkCard artwork={a} />)}
    </div>
  </section>

  <PreviewBand />

  <!-- Trade strip -->
  <section class="band--wall trade-strip">
    <div class="wrap strip-row">
      <b>Interior designers, architects &amp; developers:</b>
      <span>trade terms · artwork mocked into your renders · project sourcing &amp; installation</span>
      <a href="/designers">For Designers →</a>
    </div>
  </section>

  <!-- Visit -->
  <section class="wrap visit-row">
    <span><b>Visit</b> · {facts.address.street}, {facts.address.area} · <a class="textlink" href={facts.address.mapsUrl} target="_blank" rel="noopener">Map</a></span>
    <span><b>Hours</b> · {facts.hoursTime}{facts.hoursDays ? `, ${facts.hoursDays}` : ' (opening days being confirmed)'}</span>
  </section>
</Base>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; }
  @media (max-width: 760px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero-txt { padding: 48px 0 40px; }
  .hero-artist { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--hair); }
  .hero-artist:hover { color: var(--teak); border-color: var(--teak); }
  .hero-ctas { display: flex; gap: 22px; align-items: flex-start; flex-wrap: wrap; }
  .hero-ctas .textlink { margin-top: 14px; }
  .hero-art { background: var(--wall); padding: 36px 28px; display: flex; justify-content: center; align-items: center; align-self: stretch; }
  .frame {
    background: #fffdf9; padding: 12px; margin: 0; width: min(80%, 250px);
    box-shadow: 0 14px 30px -14px rgba(60, 45, 30, 0.4), 0 2px 6px rgba(60, 45, 30, 0.12);
  }
  .frame .ph { aspect-ratio: 4 / 5; }
  .frame figcaption { font-size: 10px; color: var(--dim); padding-top: 8px; text-align: center; letter-spacing: 0.05em; }

  .artist-strip { padding: 15px 0; }
  .strip-row { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: baseline; }
  .artist-strip .name { font-size: 15px; font-weight: 600; }
  .artist-strip .cv-line { font-size: 11px; color: var(--dim); letter-spacing: 0.04em; }

  .trade-strip { padding: 22px 0; font-size: 12.5px; color: var(--dim); }
  .trade-strip b { color: var(--ink); font-weight: 600; }
  .trade-strip a { color: var(--teak); font-weight: 600; text-decoration: none; white-space: nowrap; }

  .visit-row { display: flex; flex-wrap: wrap; gap: 8px 30px; padding-top: 24px; font-size: 12px; color: var(--dim); }
  .visit-row b { color: var(--ink); font-weight: 600; }
</style>
