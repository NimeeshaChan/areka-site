---
import '../styles/global.css';
import facts from '../data/facts.json';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';

interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = '' } = Astro.props;

const nav = [
  { href: '/collection', label: 'Collection', key: 'collection' },
  { href: '/artists', label: 'Artists', key: 'artists' },
  { href: '/preview', label: 'Wall Preview', key: 'preview' },
  { href: '/designers', label: 'For Designers', key: 'designers', hot: true },
  { href: '/about', label: 'Visit', key: 'about' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ArtGallery',
  name: facts.name,
  slogan: facts.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '29-1, First Floor, Jalan SS 2/67',
    addressLocality: 'Petaling Jaya',
    postalCode: '47300',
    addressRegion: 'Selangor',
    addressCountry: 'MY',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!facts.launch && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={facts.name} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={new URL('/og-card.png', Astro.url.origin).href} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header>
      <div class="topstrip">
        {facts.hoursDays
          ? <Fragment><b>Open {facts.hoursTime}</b> · {facts.hoursDays} · Free entry · First floor, Jalan SS 2/67</Fragment>
          : <Fragment><b>Open {facts.hoursTime}</b> · days being confirmed · Free entry · First floor, Jalan SS 2/67</Fragment>}
      </div>

      <div class="site-nav">
      <div class="wrap navrow">
        <a href="/" class="wordmark serif">ART DE AREKA</a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={['navlink', { 'navlink--hot': item.hot, 'navlink--active': active === item.key }]}
            >{item.label}</a>
          ))}
        </nav>
      </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <p class="foot-wordmark serif">Art De Areka</p>
            <p class="foot-line">{facts.tagline}</p>
          </div>
          <div>
            <p class="foot-h">Visit</p>
            <p class="foot-line">{facts.address.full}</p>
            <p class="foot-line">
              {facts.hoursTime}
              {facts.hoursDays ? ` · ${facts.hoursDays}` : ' · opening days being confirmed'}
            </p>
          </div>
          <div>
            <p class="foot-h">Contact</p>
            <p class="foot-line">
              {facts.whatsapp ? `WhatsApp ${facts.whatsapp}` : 'WhatsApp — number being confirmed'}
            </p>
            <p class="foot-line"><a href="/how-buying-works">How buying works</a> · <a href="/privacy">Privacy</a></p>
          </div>
        </div>
        <p class="foot-legal">
          © {new Date().getFullYear()} Art De Areka{facts.establishedYear ? ` · Est. ${facts.establishedYear}` : ''}{facts.ssmNumber ? ` · ${facts.ssmNumber}` : ''}
        </p>
      </div>
    </footer>

    <WhatsAppCTA variant="float" prefill="Hi Art De Areka, I found you through your website." />
  </body>
</html>

<style>
  .topstrip {
    background: var(--ink);
    color: #f3ede2;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
    padding: 8px 12px;
  }
  .topstrip b { color: #e4c9a4; font-weight: 600; }

  .site-nav { border-bottom: 1px solid var(--ink); background: var(--bg); }
  .navrow { display: flex; justify-content: space-between; align-items: center; padding-top: 16px; padding-bottom: 16px; gap: 14px; flex-wrap: wrap; }
  .wordmark { font-size: 15px; letter-spacing: 0.12em; font-weight: 600; color: var(--ink); text-decoration: none; }
  nav { display: flex; gap: 16px; flex-wrap: wrap; }
  /* single scrollable row on mobile — no ragged two-line wrap, For Designers stays visible */
  @media (max-width: 640px) {
    .navrow { flex-direction: column; align-items: flex-start; gap: 10px; }
    nav { flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 4px; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  }
  .navlink {
    font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.09em;
    color: var(--dim); text-decoration: none; font-weight: 500;
    padding: 8px 2px; white-space: nowrap;
  }
  .navlink:hover { color: var(--ink); }
  .navlink--hot { color: var(--teak); font-weight: 600; }
  .navlink--active { color: var(--ink); font-weight: 700; }

  .site-footer { border-top: 1px solid var(--ink); margin-top: 70px; padding: 40px 0 90px; }
  .foot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
  @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr; } }
  .foot-wordmark { font-size: 16px; font-weight: 600; margin: 0 0 6px; }
  .foot-h { font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--dim); margin: 0 0 6px; font-weight: 600; }
  .foot-line { font-size: 12.5px; color: var(--dim); margin: 0 0 4px; max-width: 34ch; }
  .foot-line a { color: var(--teak); text-decoration: none; font-weight: 600; }
  .foot-legal { font-size: 11px; color: var(--dim); margin: 26px 0 0; border-top: 1px solid var(--hair); padding-top: 14px; }
</style>
